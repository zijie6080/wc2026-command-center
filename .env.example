# ============================================================
#  World Cup 2026 Command Center — Environment Variables
# ============================================================
#  Copy this file to .env.local and fill in real values
# ============================================================

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development

# ---- Football API ----
NEXT_PUBLIC_FOOTBALL_API_URL=https://api.football-data.org/v4
FOOTBALL_API_KEY=your-api-key-here
NEXT_PUBLIC_FOOTBALL_API_PROVIDER=football-data

# ---- Mock Mode ----
NEXT_PUBLIC_API_MOCK_MODE=true
NEXT_PUBLIC_API_CACHE_TTL_S=60
NEXT_PUBLIC_API_TIMEOUT_MS=10000

# ---- AI Analysis (server-side only, do NOT prefix with NEXT_PUBLIC_) ----
AI_API_KEY=sk-your-openai-compatible-api-key
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
